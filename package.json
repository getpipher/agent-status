{
  "name": "@getpipher/agent-status",
  "version": "0.2.3",
  "description": "Pi coding-agent lifecycle state as a colored dot in your tmux window tab \u2014 per-window rollup (working/mixed/idle) at a glance, no polling.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "tmux",
    "tmux-status-bar",
    "agent-status",
    "coding-agent",
    "terminal",
    "developer-tools",
    "catppuccin"
  ],
  "license": "MIT",
  "author": "RECTOR <rector@rectorspace.com>",
  "homepage": "https://github.com/getpipher/agent-status",
  "repository": {
    "type": "git",
    "url": "https://github.com/getpipher/agent-status.git"
  },
  "bugs": {
    "url": "https://github.com/getpipher/agent-status/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./extensions/agent-status.ts"
    ]
  },
  "files": [
    "extensions",
    "lib",
    "tmux",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "test:run": "tsx --test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@getpipher/term": "*",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
